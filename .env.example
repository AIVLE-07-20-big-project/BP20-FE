# 로컬 개발에서는 비워 두고 Vite의 /api 프록시를 사용합니다.
# 운영 환경에서 API가 별도 Origin에 배포된 경우에만 주소를 입력합니다.
VITE_API_BASE_URL=

# Docker Compose Spring Boot: http://localhost:8081
# Spring Boot 로컬 직접 실행: http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:8081

# Google reCAPTCHA v3 공개 사이트 키입니다. 비워 두면 토큰을 발급하지 않습니다.
VITE_RECAPTCHA_SITE_KEY=

# 법적 고지 화면에 표시할 실제 운영자·개인정보 보호 연락처입니다.
# 운영 배포 전 반드시 실제 정보로 설정합니다.
VITE_LEGAL_OPERATOR_NAME=Market Poke 프로젝트팀
VITE_PRIVACY_DEPARTMENT=개인정보 보호 담당
VITE_PRIVACY_OFFICER=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_PRIVACY_CONTACT_PHONE=
VITE_LEGAL_BUSINESS_ADDRESS=
VITE_SERVICE_NAME=Market Poke
